		<properties node_id="2" format="literal">{'__version__': 99, 'currentScriptIndex': 0, 'scriptText': '# INDICATORI PER PAESE E SEMAFORI\n# ---------------------------------------------------------------------------\n# Che cosa entra : due tabelle, in qualunque ordine.\n#                  - il consuntivo: i risultati effettivi, una riga per paese e per trimestre;\n#                  - gli obiettivi: i traguardi fissati per ogni paese.\n#                  Quando le tabelle in ingresso sono più di una, Orange le consegna\n#                  al programma tutte insieme, nella lista in_datas.\n# Che cosa esce  : out_data, una riga per paese con gli indicatori degli ultimi 12 mesi,\n#                  gli obiettivi e un semaforo.\n#\n# Gli indicatori:\n#   utile netto   somma degli ultimi quattro trimestri, in milioni di euro;\n#   cost/income   costi operativi divisi per proventi, in percentuale (più è basso, meglio è);\n#   NPL ratio     crediti deteriorati divisi per impieghi, in percentuale, a fine periodo\n#                 (più è basso, meglio è).\n# I proventi sono i ricavi: qui la somma di margine di interesse e commissioni nette.\n#\n# Il semaforo riassume tre controlli, uno per indicatore:\n#   verde  = tutti gli obiettivi raggiunti;\n#   giallo = un obiettivo mancato;\n#   rosso  = due o tre obiettivi mancati.\n\nimport numpy as np\nfrom Orange.data import ContinuousVariable, DiscreteVariable, Domain, StringVariable, Table\n\nTRIMESTRI_IN_UN_ANNO = 4\nSEMAFORI = ["verde", "giallo", "rosso"]\n# Un colore è una terna di numeri da 0 a 255: quanto rosso, quanto verde, quanto blu.\nCOLORI = {"verde": (60, 170, 90), "giallo": (240, 190, 40), "rosso": (215, 60, 50)}\n\n# Le colonne numeriche della tabella in uscita, nell\'ordine in cui compaiono.\nCOLONNE_NUMERICHE = ["utile_netto_mln", "cost_income_pct", "npl_ratio_pct", "variazione_utile_pct",\n                     "proventi_mln", "impieghi_mld",\n                     "obiettivo_utile_netto_mln", "obiettivo_cost_income_pct", "soglia_npl_ratio_pct"]\n\n\ndef trova_tabella(tabelle, colonna):\n    """Tra le tabelle ricevute restituisce quella che contiene la colonna indicata.\n\n    Se nessuna la contiene restituisce None, che in Python significa «nessun valore».\n    """\n    for tabella in tabelle:\n        if tabella is not None and colonna in tabella.domain:\n            return tabella\n    return None\n\n\ndef rapporto(numeratore, denominatore):\n    """Divide due numeri. Se il denominatore è zero restituisce "nan" (not a number, «non è un numero»)."""\n    if denominatore == 0:\n        return float("nan")\n    return numeratore / denominatore\n\n\ndef utile_della_scheda(scheda):\n    """Serve a ordinare i paesi dal più redditizio al meno redditizio."""\n    return scheda["utile_netto_mln"]\n\n\ndef indicatori_per_paese(tabelle):\n    """Calcola gli indicatori di ogni paese, li confronta con gli obiettivi e assegna il semaforo."""\n    consuntivo = trova_tabella(tabelle, "trimestre")\n    obiettivi = trova_tabella(tabelle, "obiettivo_utile_netto_mln")\n    if consuntivo is None or obiettivi is None:\n        print("Servono due tabelle in ingresso: il consuntivo trimestrale e gli obiettivi per paese.")\n        return None\n\n    # 1) I periodi. I nomi dei trimestri (per esempio 2026-T3) messi in ordine alfabetico\n    #    risultano anche in ordine di tempo.\n    trimestri = sorted({str(riga["trimestre"]) for riga in consuntivo})\n    if len(trimestri) &lt; 2 * TRIMESTRI_IN_UN_ANNO:\n        print("Servono almeno otto trimestri: quattro per gli ultimi 12 mesi e quattro per i 12 mesi precedenti.")\n        return None\n    ultimi = trimestri[-TRIMESTRI_IN_UN_ANNO:]                                  # gli ultimi 12 mesi\n    precedenti = trimestri[-2 * TRIMESTRI_IN_UN_ANNO:-TRIMESTRI_IN_UN_ANNO]    # i 12 mesi precedenti\n    ultimo = trimestri[-1]\n    print("Ultimi 12 mesi   :", ultimi[0], "...", ultimi[-1])\n    print("12 mesi precedenti:", precedenti[0], "...", precedenti[-1])\n\n    # 2) Le somme per paese. Per ogni paese un dizionario raccoglie i totali.\n    totali = {}\n    for riga in consuntivo:\n        paese = str(riga["paese"])\n        trimestre = str(riga["trimestre"])\n        if paese not in totali:\n            totali[paese] = {"area": str(riga["area"]), "proventi": 0.0, "costi": 0.0, "utile": 0.0,\n                             "utile_precedente": 0.0, "impieghi": 0.0, "deteriorati": 0.0}\n        totale = totali[paese]\n        if trimestre in ultimi:\n            totale["proventi"] += float(riga["margine_interesse_mln"]) + float(riga["commissioni_nette_mln"])\n            totale["costi"] += float(riga["costi_operativi_mln"])\n            totale["utile"] += float(riga["utile_netto_mln"])\n        elif trimestre in precedenti:\n            totale["utile_precedente"] += float(riga["utile_netto_mln"])\n        if trimestre == ultimo:\n            # Impieghi e crediti deteriorati non si sommano nel tempo: vale la situazione di fine periodo.\n            totale["impieghi"] = float(riga["impieghi_mld"])\n            totale["deteriorati"] = float(riga["crediti_deteriorati_mld"])\n\n    # 3) Gli obiettivi di ogni paese: utile minimo, cost/income massimo, NPL ratio massimo.\n    traguardi = {}\n    for riga in obiettivi:\n        traguardi[str(riga["paese"])] = (float(riga["obiettivo_utile_netto_mln"]),\n                                         float(riga["obiettivo_cost_income_pct"]),\n                                         float(riga["soglia_npl_ratio_pct"]))\n\n    # 4) Per ogni paese: indicatori, confronto con gli obiettivi, semaforo.\n    schede = []\n    for paese, totale in totali.items():\n        if paese not in traguardi:\n            print("Nessun obiettivo per", paese + ": il paese resta fuori dal cruscotto.")\n            continue\n        obiettivo_utile, obiettivo_cost_income, soglia_npl = traguardi[paese]\n        cost_income = rapporto(totale["costi"], totale["proventi"]) * 100\n        npl_ratio = rapporto(totale["deteriorati"], totale["impieghi"]) * 100\n        variazione_utile = (rapporto(totale["utile"], totale["utile_precedente"]) - 1) * 100\n\n        mancati = []                                    # i nomi degli obiettivi mancati\n        if totale["utile"] &lt; obiettivo_utile:           # l\'utile deve raggiungere almeno l\'obiettivo\n            mancati.append("utile")\n        if cost_income &gt; obiettivo_cost_income:         # il cost/income non deve superare l\'obiettivo\n            mancati.append("cost/income")\n        if npl_ratio &gt; soglia_npl:                      # l\'NPL ratio non deve superare la soglia\n            mancati.append("NPL ratio")\n        semaforo = SEMAFORI[min(len(mancati), 2)]       # 0 mancati = verde, 1 = giallo, 2 o 3 = rosso\n\n        schede.append({\n            "paese": paese,\n            "area": totale["area"],\n            "semaforo": semaforo,\n            "obiettivi_mancati": ", ".join(mancati) if mancati else "nessuno",\n            "utile_netto_mln": totale["utile"],\n            "cost_income_pct": cost_income,\n            "npl_ratio_pct": npl_ratio,\n            "variazione_utile_pct": variazione_utile,\n            "proventi_mln": totale["proventi"],\n            "impieghi_mld": totale["impieghi"],\n            "obiettivo_utile_netto_mln": obiettivo_utile,\n            "obiettivo_cost_income_pct": obiettivo_cost_income,\n            "soglia_npl_ratio_pct": soglia_npl,\n        })\n\n    if not schede:\n        print("Nessun paese ha sia i risultati sia gli obiettivi.")\n        return None\n\n    # Ordiniamo i paesi dall\'utile più alto al più basso: il grafico a barre seguirà quest\'ordine.\n    schede.sort(key=utile_della_scheda, reverse=True)\n\n    print("Paesi nel cruscotto:", len(schede))\n    for nome in SEMAFORI:\n        print("   semaforo", nome + ":", sum(1 for scheda in schede if scheda["semaforo"] == nome))\n\n    # 5) La tabella per Orange. Il "dominio" è la descrizione delle colonne di una tabella.\n    #    Orange conserva una colonna a categorie come numeri: 0 per la prima categoria, 1 per la seconda...\n    paesi = [scheda["paese"] for scheda in schede]\n    aree = sorted({scheda["area"] for scheda in schede})\n\n    colonna_semaforo = DiscreteVariable("semaforo", values=SEMAFORI)\n    try:\n        # Diamo a ogni valore del semaforo il suo colore: tabelle e grafici lo useranno.\n        colonna_semaforo.colors = np.array([COLORI[nome] for nome in SEMAFORI], dtype=np.uint8)\n    except Exception:\n        pass    # se questa versione di Orange non lo permette, restano i colori predefiniti\n\n    dominio = Domain(\n        [ContinuousVariable(nome, number_of_decimals=1) for nome in COLONNE_NUMERICHE]\n        + [DiscreteVariable("area", values=aree)],\n        [colonna_semaforo],     # colonna speciale, che Orange chiama «target»: la usa per i colori\n        metas=[DiscreteVariable("paese", values=paesi), StringVariable("obiettivi_mancati")],\n    )\n    numeri = [[scheda[nome] for nome in COLONNE_NUMERICHE] + [aree.index(scheda["area"])] for scheda in schede]\n    semafori = [SEMAFORI.index(scheda["semaforo"]) for scheda in schede]\n    descrizioni = [[float(paesi.index(scheda["paese"])), scheda["obiettivi_mancati"]] for scheda in schede]\n    return Table.from_numpy(\n        dominio,\n        np.array(numeri, dtype=float),\n        np.array(semafori, dtype=float),\n        metas=np.array(descrizioni, dtype=object),\n    )\n\n\n# Orange legge il risultato dalla variabile out_data e lo passa ai widget successivi.\nout_data = indicatori_per_paese(in_datas)\n', 'scriptLibrary': [{'name': 'Indicatori per paese e semafori', 'script': '# INDICATORI PER PAESE E SEMAFORI\n# ---------------------------------------------------------------------------\n# Che cosa entra : due tabelle, in qualunque ordine.\n#                  - il consuntivo: i risultati effettivi, una riga per paese e per trimestre;\n#                  - gli obiettivi: i traguardi fissati per ogni paese.\n#                  Quando le tabelle in ingresso sono più di una, Orange le consegna\n#                  al programma tutte insieme, nella lista in_datas.\n# Che cosa esce  : out_data, una riga per paese con gli indicatori degli ultimi 12 mesi,\n#                  gli obiettivi e un semaforo.\n#\n# Gli indicatori:\n#   utile netto   somma degli ultimi quattro trimestri, in milioni di euro;\n#   cost/income   costi operativi divisi per proventi, in percentuale (più è basso, meglio è);\n#   NPL ratio     crediti deteriorati divisi per impieghi, in percentuale, a fine periodo\n#                 (più è basso, meglio è).\n# I proventi sono i ricavi: qui la somma di margine di interesse e commissioni nette.\n#\n# Il semaforo riassume tre controlli, uno per indicatore:\n#   verde  = tutti gli obiettivi raggiunti;\n#   giallo = un obiettivo mancato;\n#   rosso  = due o tre obiettivi mancati.\n\nimport numpy as np\nfrom Orange.data import ContinuousVariable, DiscreteVariable, Domain, StringVariable, Table\n\nTRIMESTRI_IN_UN_ANNO = 4\nSEMAFORI = ["verde", "giallo", "rosso"]\n# Un colore è una terna di numeri da 0 a 255: quanto rosso, quanto verde, quanto blu.\nCOLORI = {"verde": (60, 170, 90), "giallo": (240, 190, 40), "rosso": (215, 60, 50)}\n\n# Le colonne numeriche della tabella in uscita, nell\'ordine in cui compaiono.\nCOLONNE_NUMERICHE = ["utile_netto_mln", "cost_income_pct", "npl_ratio_pct", "variazione_utile_pct",\n                     "proventi_mln", "impieghi_mld",\n                     "obiettivo_utile_netto_mln", "obiettivo_cost_income_pct", "soglia_npl_ratio_pct"]\n\n\ndef trova_tabella(tabelle, colonna):\n    """Tra le tabelle ricevute restituisce quella che contiene la colonna indicata.\n\n    Se nessuna la contiene restituisce None, che in Python significa «nessun valore».\n    """\n    for tabella in tabelle:\n        if tabella is not None and colonna in tabella.domain:\n            return tabella\n    return None\n\n\ndef rapporto(numeratore, denominatore):\n    """Divide due numeri. Se il denominatore è zero restituisce "nan" (not a number, «non è un numero»)."""\n    if denominatore == 0:\n        return float("nan")\n    return numeratore / denominatore\n\n\ndef utile_della_scheda(scheda):\n    """Serve a ordinare i paesi dal più redditizio al meno redditizio."""\n    return scheda["utile_netto_mln"]\n\n\ndef indicatori_per_paese(tabelle):\n    """Calcola gli indicatori di ogni paese, li confronta con gli obiettivi e assegna il semaforo."""\n    consuntivo = trova_tabella(tabelle, "trimestre")\n    obiettivi = trova_tabella(tabelle, "obiettivo_utile_netto_mln")\n    if consuntivo is None or obiettivi is None:\n        print("Servono due tabelle in ingresso: il consuntivo trimestrale e gli obiettivi per paese.")\n        return None\n\n    # 1) I periodi. I nomi dei trimestri (per esempio 2026-T3) messi in ordine alfabetico\n    #    risultano anche in ordine di tempo.\n    trimestri = sorted({str(riga["trimestre"]) for riga in consuntivo})\n    if len(trimestri) &lt; 2 * TRIMESTRI_IN_UN_ANNO:\n        print("Servono almeno otto trimestri: quattro per gli ultimi 12 mesi e quattro per i 12 mesi precedenti.")\n        return None\n    ultimi = trimestri[-TRIMESTRI_IN_UN_ANNO:]                                  # gli ultimi 12 mesi\n    precedenti = trimestri[-2 * TRIMESTRI_IN_UN_ANNO:-TRIMESTRI_IN_UN_ANNO]    # i 12 mesi precedenti\n    ultimo = trimestri[-1]\n    print("Ultimi 12 mesi   :", ultimi[0], "...", ultimi[-1])\n    print("12 mesi precedenti:", precedenti[0], "...", precedenti[-1])\n\n    # 2) Le somme per paese. Per ogni paese un dizionario raccoglie i totali.\n    totali = {}\n    for riga in consuntivo:\n        paese = str(riga["paese"])\n        trimestre = str(riga["trimestre"])\n        if paese not in totali:\n            totali[paese] = {"area": str(riga["area"]), "proventi": 0.0, "costi": 0.0, "utile": 0.0,\n                             "utile_precedente": 0.0, "impieghi": 0.0, "deteriorati": 0.0}\n        totale = totali[paese]\n        if trimestre in ultimi:\n            totale["proventi"] += float(riga["margine_interesse_mln"]) + float(riga["commissioni_nette_mln"])\n            totale["costi"] += float(riga["costi_operativi_mln"])\n            totale["utile"] += float(riga["utile_netto_mln"])\n        elif trimestre in precedenti:\n            totale["utile_precedente"] += float(riga["utile_netto_mln"])\n        if trimestre == ultimo:\n            # Impieghi e crediti deteriorati non si sommano nel tempo: vale la situazione di fine periodo.\n            totale["impieghi"] = float(riga["impieghi_mld"])\n            totale["deteriorati"] = float(riga["crediti_deteriorati_mld"])\n\n    # 3) Gli obiettivi di ogni paese: utile minimo, cost/income massimo, NPL ratio massimo.\n    traguardi = {}\n    for riga in obiettivi:\n        traguardi[str(riga["paese"])] = (float(riga["obiettivo_utile_netto_mln"]),\n                                         float(riga["obiettivo_cost_income_pct"]),\n                                         float(riga["soglia_npl_ratio_pct"]))\n\n    # 4) Per ogni paese: indicatori, confronto con gli obiettivi, semaforo.\n    schede = []\n    for paese, totale in totali.items():\n        if paese not in traguardi:\n            print("Nessun obiettivo per", paese + ": il paese resta fuori dal cruscotto.")\n            continue\n        obiettivo_utile, obiettivo_cost_income, soglia_npl = traguardi[paese]\n        cost_income = rapporto(totale["costi"], totale["proventi"]) * 100\n        npl_ratio = rapporto(totale["deteriorati"], totale["impieghi"]) * 100\n        variazione_utile = (rapporto(totale["utile"], totale["utile_precedente"]) - 1) * 100\n\n        mancati = []                                    # i nomi degli obiettivi mancati\n        if totale["utile"] &lt; obiettivo_utile:           # l\'utile deve raggiungere almeno l\'obiettivo\n            mancati.append("utile")\n        if cost_income &gt; obiettivo_cost_income:         # il cost/income non deve superare l\'obiettivo\n            mancati.append("cost/income")\n        if npl_ratio &gt; soglia_npl:                      # l\'NPL ratio non deve superare la soglia\n            mancati.append("NPL ratio")\n        semaforo = SEMAFORI[min(len(mancati), 2)]       # 0 mancati = verde, 1 = giallo, 2 o 3 = rosso\n\n        schede.append({\n            "paese": paese,\n            "area": totale["area"],\n            "semaforo": semaforo,\n            "obiettivi_mancati": ", ".join(mancati) if mancati else "nessuno",\n            "utile_netto_mln": totale["utile"],\n            "cost_income_pct": cost_income,\n            "npl_ratio_pct": npl_ratio,\n            "variazione_utile_pct": variazione_utile,\n            "proventi_mln": totale["proventi"],\n            "impieghi_mld": totale["impieghi"],\n            "obiettivo_utile_netto_mln": obiettivo_utile,\n            "obiettivo_cost_income_pct": obiettivo_cost_income,\n            "soglia_npl_ratio_pct": soglia_npl,\n        })\n\n    if not schede:\n        print("Nessun paese ha sia i risultati sia gli obiettivi.")\n        return None\n\n    # Ordiniamo i paesi dall\'utile più alto al più basso: il grafico a barre seguirà quest\'ordine.\n    schede.sort(key=utile_della_scheda, reverse=True)\n\n    print("Paesi nel cruscotto:", len(schede))\n    for nome in SEMAFORI:\n        print("   semaforo", nome + ":", sum(1 for scheda in schede if scheda["semaforo"] == nome))\n\n    # 5) La tabella per Orange. Il "dominio" è la descrizione delle colonne di una tabella.\n    #    Orange conserva una colonna a categorie come numeri: 0 per la prima categoria, 1 per la seconda...\n    paesi = [scheda["paese"] for scheda in schede]\n    aree = sorted({scheda["area"] for scheda in schede})\n\n    colonna_semaforo = DiscreteVariable("semaforo", values=SEMAFORI)\n    try:\n        # Diamo a ogni valore del semaforo il suo colore: tabelle e grafici lo useranno.\n        colonna_semaforo.colors = np.array([COLORI[nome] for nome in SEMAFORI], dtype=np.uint8)\n    except Exception:\n        pass    # se questa versione di Orange non lo permette, restano i colori predefiniti\n\n    dominio = Domain(\n        [ContinuousVariable(nome, number_of_decimals=1) for nome in COLONNE_NUMERICHE]\n        + [DiscreteVariable("area", values=aree)],\n        [colonna_semaforo],     # colonna speciale, che Orange chiama «target»: la usa per i colori\n        metas=[DiscreteVariable("paese", values=paesi), StringVariable("obiettivi_mancati")],\n    )\n    numeri = [[scheda[nome] for nome in COLONNE_NUMERICHE] + [aree.index(scheda["area"])] for scheda in schede]\n    semafori = [SEMAFORI.index(scheda["semaforo"]) for scheda in schede]\n    descrizioni = [[float(paesi.index(scheda["paese"])), scheda["obiettivi_mancati"]] for scheda in schede]\n    return Table.from_numpy(\n        dominio,\n        np.array(numeri, dtype=float),\n        np.array(semafori, dtype=float),\n        metas=np.array(descrizioni, dtype=object),\n    )\n\n\n# Orange legge il risultato dalla variabile out_data e lo passa ai widget successivi.\nout_data = indicatori_per_paese(in_datas)\n', 'filename': None}], 'controlAreaVisible': True}</properties>
		<properties node_id="3" format="literal">{'__version__': 99, 'currentScriptIndex': 0, 'scriptText': '# IL QUADRO DEL GRUPPO\n# ---------------------------------------------------------------------------\n# Che cosa entra : in_data, la tabella prodotta da "Indicatori per paese" (una riga per paese).\n# Che cosa esce  : out_data, tre righe: un indicatore dell\'intera banca per riga,\n#                  accanto al suo obiettivo e allo stato (raggiunto oppure mancato).\n#\n# Attenzione alle percentuali: per il gruppo non facciamo la media delle percentuali dei paesi,\n# perché i paesi hanno dimensioni molto diverse. Rifacciamo il rapporto sui totali. Per esempio:\n#   cost/income del gruppo = costi di tutti i paesi / proventi di tutti i paesi.\n\nimport numpy as np\nfrom Orange.data import ContinuousVariable, DiscreteVariable, Domain, StringVariable, Table\n\n# --- Parametri: possiamo cambiarli e poi premere il pulsante Run -------------\nOBIETTIVO_COST_INCOME_GRUPPO = 55.0    # per cento: il cost/income del gruppo non deve superarlo\nSOGLIA_NPL_RATIO_GRUPPO = 3.0          # per cento: l\'NPL ratio del gruppo non deve superarla\n\nSTATI = ["raggiunto", "mancato"]\nCOLONNE_NECESSARIE = ["utile_netto_mln", "obiettivo_utile_netto_mln", "proventi_mln",\n                      "cost_income_pct", "impieghi_mld", "npl_ratio_pct"]\n\n\ndef quadro_del_gruppo(paesi):\n    """Somma i paesi e restituisce la tabella con i tre indicatori del gruppo."""\n    if paesi is None or len(paesi) == 0:\n        print("In attesa dei dati: colleghiamo il widget \'Indicatori per paese\' all\'ingresso di questo widget.")\n        return None\n\n    # Controlliamo che la tabella ricevuta contenga le colonne che ci servono.\n    mancanti = [colonna for colonna in COLONNE_NECESSARIE if colonna not in paesi.domain]\n    if mancanti:\n        print("Nella tabella in ingresso mancano queste colonne:", ", ".join(mancanti))\n        return None\n\n    # 1) I totali del gruppo.\n    utile = obiettivo_utile = proventi = costi = impieghi = deteriorati = 0.0\n    for riga in paesi:\n        proventi_del_paese = float(riga["proventi_mln"])\n        impieghi_del_paese = float(riga["impieghi_mld"])\n        utile += float(riga["utile_netto_mln"])\n        obiettivo_utile += float(riga["obiettivo_utile_netto_mln"])\n        proventi += proventi_del_paese\n        impieghi += impieghi_del_paese\n        # Dalla percentuale risaliamo al valore: costi = proventi x cost/income / 100.\n        costi += proventi_del_paese * float(riga["cost_income_pct"]) / 100\n        # Allo stesso modo: crediti deteriorati = impieghi x NPL ratio / 100.\n        deteriorati += impieghi_del_paese * float(riga["npl_ratio_pct"]) / 100\n\n    if proventi == 0 or impieghi == 0:\n        print("Proventi o impieghi del gruppo valgono zero: non possiamo calcolare le percentuali.")\n        return None\n    cost_income = costi / proventi * 100\n    npl_ratio = deteriorati / impieghi * 100\n\n    # 2) Un indicatore per riga: nome, unità di misura, tipo di obiettivo, valore, obiettivo, esito.\n    #    L\'obiettivo di utile del gruppo è la somma degli obiettivi dei paesi.\n    indicatori = [\n        ("Utile netto degli ultimi 12 mesi", "milioni di euro", "minimo da raggiungere",\n         utile, obiettivo_utile, utile &gt;= obiettivo_utile),\n        ("Cost/income", "per cento", "massimo da non superare",\n         cost_income, OBIETTIVO_COST_INCOME_GRUPPO, cost_income &lt;= OBIETTIVO_COST_INCOME_GRUPPO),\n        ("NPL ratio", "per cento", "massimo da non superare",\n         npl_ratio, SOGLIA_NPL_RATIO_GRUPPO, npl_ratio &lt;= SOGLIA_NPL_RATIO_GRUPPO),\n    ]\n\n    # Riepilogo nella console, il riquadro in basso di questo widget.\n    for nome, unita, tipo, valore, obiettivo, raggiunto in indicatori:\n        print(nome + ":", round(valore, 2), "| obiettivo:", round(obiettivo, 2),\n              "|", "raggiunto" if raggiunto else "mancato")\n\n    # 3) La tabella per Orange. Il "dominio" è la descrizione delle colonne di una tabella.\n    dominio = Domain(\n        [ContinuousVariable("valore", number_of_decimals=2),\n         ContinuousVariable("obiettivo", number_of_decimals=2),\n         ContinuousVariable("differenza", number_of_decimals=2)],\n        [DiscreteVariable("stato", values=STATI)],     # colonna speciale, che Orange chiama «target»\n        metas=[StringVariable("indicatore"), StringVariable("unita_di_misura"), StringVariable("tipo_di_obiettivo")],\n    )\n    numeri = [[valore, obiettivo, valore - obiettivo]\n              for nome, unita, tipo, valore, obiettivo, raggiunto in indicatori]\n    stati = [0.0 if raggiunto else 1.0 for nome, unita, tipo, valore, obiettivo, raggiunto in indicatori]\n    descrizioni = [[nome, unita, tipo] for nome, unita, tipo, valore, obiettivo, raggiunto in indicatori]\n    return Table.from_numpy(\n        dominio,\n        np.array(numeri, dtype=float),\n        np.array(stati, dtype=float),\n        metas=np.array(descrizioni, dtype=object),\n    )\n\n\n# Orange legge il risultato dalla variabile out_data e lo passa al widget successivo.\nout_data = quadro_del_gruppo(in_data)\n', 'scriptLibrary': [{'name': 'Quadro del gruppo', 'script': '# IL QUADRO DEL GRUPPO\n# ---------------------------------------------------------------------------\n# Che cosa entra : in_data, la tabella prodotta da "Indicatori per paese" (una riga per paese).\n# Che cosa esce  : out_data, tre righe: un indicatore dell\'intera banca per riga,\n#                  accanto al suo obiettivo e allo stato (raggiunto oppure mancato).\n#\n# Attenzione alle percentuali: per il gruppo non facciamo la media delle percentuali dei paesi,\n# perché i paesi hanno dimensioni molto diverse. Rifacciamo il rapporto sui totali. Per esempio:\n#   cost/income del gruppo = costi di tutti i paesi / proventi di tutti i paesi.\n\nimport numpy as np\nfrom Orange.data import ContinuousVariable, DiscreteVariable, Domain, StringVariable, Table\n\n# --- Parametri: possiamo cambiarli e poi premere il pulsante Run -------------\nOBIETTIVO_COST_INCOME_GRUPPO = 55.0    # per cento: il cost/income del gruppo non deve superarlo\nSOGLIA_NPL_RATIO_GRUPPO = 3.0          # per cento: l\'NPL ratio del gruppo non deve superarla\n\nSTATI = ["raggiunto", "mancato"]\nCOLONNE_NECESSARIE = ["utile_netto_mln", "obiettivo_utile_netto_mln", "proventi_mln",\n                      "cost_income_pct", "impieghi_mld", "npl_ratio_pct"]\n\n\ndef quadro_del_gruppo(paesi):\n    """Somma i paesi e restituisce la tabella con i tre indicatori del gruppo."""\n    if paesi is None or len(paesi) == 0:\n        print("In attesa dei dati: colleghiamo il widget \'Indicatori per paese\' all\'ingresso di questo widget.")\n        return None\n\n    # Controlliamo che la tabella ricevuta contenga le colonne che ci servono.\n    mancanti = [colonna for colonna in COLONNE_NECESSARIE if colonna not in paesi.domain]\n    if mancanti:\n        print("Nella tabella in ingresso mancano queste colonne:", ", ".join(mancanti))\n        return None\n\n    # 1) I totali del gruppo.\n    utile = obiettivo_utile = proventi = costi = impieghi = deteriorati = 0.0\n    for riga in paesi:\n        proventi_del_paese = float(riga["proventi_mln"])\n        impieghi_del_paese = float(riga["impieghi_mld"])\n        utile += float(riga["utile_netto_mln"])\n        obiettivo_utile += float(riga["obiettivo_utile_netto_mln"])\n        proventi += proventi_del_paese\n        impieghi += impieghi_del_paese\n        # Dalla percentuale risaliamo al valore: costi = proventi x cost/income / 100.\n        costi += proventi_del_paese * float(riga["cost_income_pct"]) / 100\n        # Allo stesso modo: crediti deteriorati = impieghi x NPL ratio / 100.\n        deteriorati += impieghi_del_paese * float(riga["npl_ratio_pct"]) / 100\n\n    if proventi == 0 or impieghi == 0:\n        print("Proventi o impieghi del gruppo valgono zero: non possiamo calcolare le percentuali.")\n        return None\n    cost_income = costi / proventi * 100\n    npl_ratio = deteriorati / impieghi * 100\n\n    # 2) Un indicatore per riga: nome, unità di misura, tipo di obiettivo, valore, obiettivo, esito.\n    #    L\'obiettivo di utile del gruppo è la somma degli obiettivi dei paesi.\n    indicatori = [\n        ("Utile netto degli ultimi 12 mesi", "milioni di euro", "minimo da raggiungere",\n         utile, obiettivo_utile, utile &gt;= obiettivo_utile),\n        ("Cost/income", "per cento", "massimo da non superare",\n         cost_income, OBIETTIVO_COST_INCOME_GRUPPO, cost_income &lt;= OBIETTIVO_COST_INCOME_GRUPPO),\n        ("NPL ratio", "per cento", "massimo da non superare",\n         npl_ratio, SOGLIA_NPL_RATIO_GRUPPO, npl_ratio &lt;= SOGLIA_NPL_RATIO_GRUPPO),\n    ]\n\n    # Riepilogo nella console, il riquadro in basso di questo widget.\n    for nome, unita, tipo, valore, obiettivo, raggiunto in indicatori:\n        print(nome + ":", round(valore, 2), "| obiettivo:", round(obiettivo, 2),\n              "|", "raggiunto" if raggiunto else "mancato")\n\n    # 3) La tabella per Orange. Il "dominio" è la descrizione delle colonne di una tabella.\n    dominio = Domain(\n        [ContinuousVariable("valore", number_of_decimals=2),\n         ContinuousVariable("obiettivo", number_of_decimals=2),\n         ContinuousVariable("differenza", number_of_decimals=2)],\n        [DiscreteVariable("stato", values=STATI)],     # colonna speciale, che Orange chiama «target»\n        metas=[StringVariable("indicatore"), StringVariable("unita_di_misura"), StringVariable("tipo_di_obiettivo")],\n    )\n    numeri = [[valore, obiettivo, valore - obiettivo]\n              for nome, unita, tipo, valore, obiettivo, raggiunto in indicatori]\n    stati = [0.0 if raggiunto else 1.0 for nome, unita, tipo, valore, obiettivo, raggiunto in indicatori]\n    descrizioni = [[nome, unita, tipo] for nome, unita, tipo, valore, obiettivo, raggiunto in indicatori]\n    return Table.from_numpy(\n        dominio,\n        np.array(numeri, dtype=float),\n        np.array(stati, dtype=float),\n        metas=np.array(descrizioni, dtype=object),\n    )\n\n\n# Orange legge il risultato dalla variabile out_data e lo passa al widget successivo.\nout_data = quadro_del_gruppo(in_data)\n', 'filename': None}], 'controlAreaVisible': True}</properties>
