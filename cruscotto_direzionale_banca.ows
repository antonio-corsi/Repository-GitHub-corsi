		<properties node_id="7" format="literal">{'__version__': 99, 'currentScriptIndex': 0, 'scriptText': '# L\'ANDAMENTO DEI PROVENTI PER AREA\n# ---------------------------------------------------------------------------\n# Che cosa entra : in_data, il consuntivo (una riga per paese e per trimestre).\n# Che cosa esce  : out_data, una riga per il gruppo e una per ogni area geografica,\n#                  con una colonna per ogni trimestre. È la forma che serve al widget\n#                  Line Plot, che disegna ogni riga come una linea.\n#\n# I proventi sono i ricavi: qui la somma di margine di interesse e commissioni nette.\n#\n# Con USA_INDICE = True ogni linea parte da 100 (un "numero indice"):\n# 110 significa «proventi cresciuti del 10% rispetto al primo trimestre».\n# Così confrontiamo aree di dimensioni molto diverse.\n# Con USA_INDICE = False restano i milioni di euro.\n\nimport numpy as np\nfrom Orange.data import ContinuousVariable, DiscreteVariable, Domain, Table\n\n# --- Parametro: possiamo cambiarlo e poi premere il pulsante Run -------------\nUSA_INDICE = True\n\nGRUPPO = "Gruppo"\nCOLONNE_NECESSARIE = ["area", "trimestre", "margine_interesse_mln", "commissioni_nette_mln"]\n\n\ndef andamento_per_area(consuntivo):\n    """Somma i proventi per area e per trimestre e restituisce una tabella con un trimestre per colonna."""\n    if consuntivo is None or len(consuntivo) == 0:\n        print("In attesa dei dati: colleghiamo il widget \'Consuntivo\' all\'ingresso di questo widget.")\n        return None\n\n    # Controlliamo che la tabella ricevuta contenga le colonne che ci servono.\n    mancanti = [colonna for colonna in COLONNE_NECESSARIE if colonna not in consuntivo.domain]\n    if mancanti:\n        print("Nella tabella in ingresso mancano queste colonne:", ", ".join(mancanti))\n        return None\n\n    # 1) Le somme. La chiave del dizionario è la coppia (area, trimestre).\n    somme = {}\n    for riga in consuntivo:\n        proventi = float(riga["margine_interesse_mln"]) + float(riga["commissioni_nette_mln"])\n        for area in (str(riga["area"]), GRUPPO):         # ogni riga conta per la sua area e per il gruppo\n            chiave = (area, str(riga["trimestre"]))\n            somme[chiave] = somme.get(chiave, 0.0) + proventi\n\n    # I nomi dei trimestri (per esempio 2026-T3) in ordine alfabetico sono anche in ordine di tempo.\n    trimestri = sorted({trimestre for area, trimestre in somme})\n    aree = [GRUPPO] + sorted({area for area, trimestre in somme if area != GRUPPO})\n\n    # 2) Una riga per area, una colonna per trimestre.\n    righe = []\n    for area in aree:\n        valori = [somme.get((area, trimestre), float("nan")) for trimestre in trimestri]\n        if USA_INDICE and valori[0] &gt; 0:\n            primo = valori[0]\n            valori = [valore / primo * 100 for valore in valori]\n        righe.append(valori)\n        print(area + ":", round(valori[0], 1), "-&gt;", round(valori[-1], 1))\n\n    # 3) La tabella per Orange. Il "dominio" è la descrizione delle colonne di una tabella.\n    #    "area" è la colonna speciale che Orange chiama «target»: Line Plot la usa\n    #    per raggruppare e colorare le linee.\n    dominio = Domain(\n        [ContinuousVariable(trimestre, number_of_decimals=1) for trimestre in trimestri],\n        [DiscreteVariable("area", values=aree)],\n    )\n    codici_area = [float(posizione) for posizione in range(len(aree))]\n    return Table.from_numpy(dominio, np.array(righe, dtype=float), np.array(codici_area, dtype=float))\n\n\n# Orange legge il risultato dalla variabile out_data e lo passa al widget successivo.\nout_data = andamento_per_area(in_data)\n', 'scriptLibrary': [{'name': 'Andamento dei proventi per area', 'script': '# L\'ANDAMENTO DEI PROVENTI PER AREA\n# ---------------------------------------------------------------------------\n# Che cosa entra : in_data, il consuntivo (una riga per paese e per trimestre).\n# Che cosa esce  : out_data, una riga per il gruppo e una per ogni area geografica,\n#                  con una colonna per ogni trimestre. È la forma che serve al widget\n#                  Line Plot, che disegna ogni riga come una linea.\n#\n# I proventi sono i ricavi: qui la somma di margine di interesse e commissioni nette.\n#\n# Con USA_INDICE = True ogni linea parte da 100 (un "numero indice"):\n# 110 significa «proventi cresciuti del 10% rispetto al primo trimestre».\n# Così confrontiamo aree di dimensioni molto diverse.\n# Con USA_INDICE = False restano i milioni di euro.\n\nimport numpy as np\nfrom Orange.data import ContinuousVariable, DiscreteVariable, Domain, Table\n\n# --- Parametro: possiamo cambiarlo e poi premere il pulsante Run -------------\nUSA_INDICE = True\n\nGRUPPO = "Gruppo"\nCOLONNE_NECESSARIE = ["area", "trimestre", "margine_interesse_mln", "commissioni_nette_mln"]\n\n\ndef andamento_per_area(consuntivo):\n    """Somma i proventi per area e per trimestre e restituisce una tabella con un trimestre per colonna."""\n    if consuntivo is None or len(consuntivo) == 0:\n        print("In attesa dei dati: colleghiamo il widget \'Consuntivo\' all\'ingresso di questo widget.")\n        return None\n\n    # Controlliamo che la tabella ricevuta contenga le colonne che ci servono.\n    mancanti = [colonna for colonna in COLONNE_NECESSARIE if colonna not in consuntivo.domain]\n    if mancanti:\n        print("Nella tabella in ingresso mancano queste colonne:", ", ".join(mancanti))\n        return None\n\n    # 1) Le somme. La chiave del dizionario è la coppia (area, trimestre).\n    somme = {}\n    for riga in consuntivo:\n        proventi = float(riga["margine_interesse_mln"]) + float(riga["commissioni_nette_mln"])\n        for area in (str(riga["area"]), GRUPPO):         # ogni riga conta per la sua area e per il gruppo\n            chiave = (area, str(riga["trimestre"]))\n            somme[chiave] = somme.get(chiave, 0.0) + proventi\n\n    # I nomi dei trimestri (per esempio 2026-T3) in ordine alfabetico sono anche in ordine di tempo.\n    trimestri = sorted({trimestre for area, trimestre in somme})\n    aree = [GRUPPO] + sorted({area for area, trimestre in somme if area != GRUPPO})\n\n    # 2) Una riga per area, una colonna per trimestre.\n    righe = []\n    for area in aree:\n        valori = [somme.get((area, trimestre), float("nan")) for trimestre in trimestri]\n        if USA_INDICE and valori[0] &gt; 0:\n            primo = valori[0]\n            valori = [valore / primo * 100 for valore in valori]\n        righe.append(valori)\n        print(area + ":", round(valori[0], 1), "-&gt;", round(valori[-1], 1))\n\n    # 3) La tabella per Orange. Il "dominio" è la descrizione delle colonne di una tabella.\n    #    "area" è la colonna speciale che Orange chiama «target»: Line Plot la usa\n    #    per raggruppare e colorare le linee.\n    dominio = Domain(\n        [ContinuousVariable(trimestre, number_of_decimals=1) for trimestre in trimestri],\n        [DiscreteVariable("area", values=aree)],\n    )\n    codici_area = [float(posizione) for posizione in range(len(aree))]\n    return Table.from_numpy(dominio, np.array(righe, dtype=float), np.array(codici_area, dtype=float))\n\n\n# Orange legge il risultato dalla variabile out_data e lo passa al widget successivo.\nout_data = andamento_per_area(in_data)\n', 'filename': None}], 'controlAreaVisible': True}</properties>
