</properties>
		<properties node_id="3" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x07\x80\x00\x00\x04\x10\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x0f\x00\x00\x00\x00\x02\x00\x00\x00\x07\x80\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x0f', 'scriptLibrary': [{'name': "Regola: candidate all'arresto", 'script': '# REGOLA: QUALI MACCHINE PROPORRE PER L\'ARRESTO\n# ---------------------------------------------------------------------------\n# Che cosa entra : in_data, cioè l\'inventario letto dal widget "Inventario"\n#                  (una riga per ogni macchina virtuale).\n# Che cosa esce  : out_data, cioè le sole macchine candidate all\'arresto,\n#                  con una colonna in più, "motivo", che spiega la proposta.\n#\n# Una macchina è candidata se è ACCESA (stato RUNNING) e in più vale una di queste regole:\n#   regola 1) non ha l\'etichetta "proprietario": nessuno risulta averla in carico;\n#   regola 2) è una macchina di collaudo e il suo ultimo avvio risale\n#             a più di SOGLIA_GIORNI giorni fa: da allora è rimasta sempre accesa.\n#\n# Questo programma non ferma nulla: prepara un elenco, che poi una persona valuterà.\n\nimport numpy as np\nfrom Orange.data import DiscreteVariable, Domain, Table\n\n# --- Parametro: possiamo cambiarlo e poi premere il pulsante Run -------------\nSOGLIA_GIORNI = 30     # giorni di accensione continua tollerati per una macchina di collaudo\n\nMOTIVI = ["senza proprietario", "collaudo accesa da troppo tempo"]\nCOLONNE_NECESSARIE = ["stato", "proprietario", "ambiente", "giorni_dall_avvio"]\n\n\ndef testo(valore):\n    """Restituisce il contenuto di una cella come testo. Una cella vuota diventa una stringa vuota."""\n    scritta = str(valore).strip()\n    # Orange mostra una cella vuota come "?": la trattiamo come vuota.\n    if scritta in ("?", "nan", "None"):\n        return ""\n    return scritta\n\n\ndef proponi_candidate(inventario):\n    """Applica le due regole all\'inventario e restituisce la tabella delle macchine candidate.\n\n    Se non c\'è nulla da proporre restituisce None, che in Python significa «nessun valore».\n    """\n    if inventario is None:\n        print("In attesa dei dati: colleghiamo il widget \'Inventario\' all\'ingresso di questo widget.")\n        return None\n\n    # Controlliamo che la tabella ricevuta contenga le colonne che le regole usano.\n    mancanti = [colonna for colonna in COLONNE_NECESSARIE if colonna not in inventario.domain]\n    if mancanti:\n        print("La tabella in ingresso non è l\'inventario atteso. Colonne mancanti:", ", ".join(mancanti))\n        return None\n\n    righe_candidate = []    # posizione, nell\'inventario, di ogni riga candidata\n    codici_motivo = []      # per ogni riga candidata: 0 = primo motivo dell\'elenco MOTIVI, 1 = secondo\n\n    # Esaminiamo l\'inventario una riga alla volta.\n    for posizione, riga in enumerate(inventario):\n        accesa = testo(riga["stato"]) == "RUNNING"\n        senza_proprietario = testo(riga["proprietario"]) == ""\n        di_collaudo = testo(riga["ambiente"]) == "collaudo"\n        giorni = float(riga["giorni_dall_avvio"])\n\n        if accesa and senza_proprietario:                          # regola 1\n            righe_candidate.append(posizione)\n            codici_motivo.append(0)\n        elif accesa and di_collaudo and giorni &gt; SOGLIA_GIORNI:    # regola 2\n            righe_candidate.append(posizione)\n            codici_motivo.append(1)\n\n    # Riepilogo: compare nella console, il riquadro in basso di questo widget.\n    print("Macchine in inventario:", len(inventario))\n    print("Candidate all\'arresto :", len(righe_candidate))\n    for numero, motivo in enumerate(MOTIVI):\n        print("   -", motivo + ":", codici_motivo.count(numero))\n\n    if not righe_candidate:\n        print("Nessuna macchina soddisfa le regole.")\n        return None\n\n    # Teniamo le sole righe candidate.\n    candidate = inventario[righe_candidate]\n\n    # Quanto costano, in un mese, le macchine candidate (i prezzi del file sono inventati).\n    # Un costo mancante vale "nan" (not a number, cioè «non è un numero»): lo scartiamo.\n    if "costo_mensile_eur" in inventario.domain:\n        costi = [float(riga["costo_mensile_eur"]) for riga in candidate]\n        costi_noti = [costo for costo in costi if not np.isnan(costo)]\n        if costi_noti:\n            print("Costo mensile delle candidate:", round(sum(costi_noti), 2), "euro")\n\n    # Aggiungiamo la colonna "motivo" in fondo alle colonne già presenti.\n    # In Orange il "dominio" è la descrizione delle colonne di una tabella.\n    # Una tabella conserva i numeri in X, la colonna obiettivo in Y (qui non c\'è)\n    # e i testi in metas: li riportiamo tali e quali, aggiungendo a X la nuova colonna.\n    colonna_motivo = DiscreteVariable("motivo", values=MOTIVI)\n    dominio = Domain(\n        list(inventario.domain.attributes) + [colonna_motivo],\n        inventario.domain.class_vars,\n        inventario.domain.metas,\n    )\n    valori = np.column_stack([candidate.X, np.array(codici_motivo, dtype=float)])\n    return Table.from_numpy(dominio, valori, candidate.Y, candidate.metas)\n\n\n# Orange legge il risultato dalla variabile out_data e lo passa al widget successivo.\nout_data = proponi_candidate(in_data)\n', 'filename': None}], 'scriptText': '# REGOLA: QUALI MACCHINE PROPORRE PER L\'ARRESTO\n# ---------------------------------------------------------------------------\n# Che cosa entra : in_data, cioè l\'inventario letto dal widget "Inventario"\n#                  (una riga per ogni macchina virtuale).\n# Che cosa esce  : out_data, cioè le sole macchine candidate all\'arresto,\n#                  con una colonna in più, "motivo", che spiega la proposta.\n#\n# Una macchina è candidata se è ACCESA (stato RUNNING) e in più vale una di queste regole:\n#   regola 1) non ha l\'etichetta "proprietario": nessuno risulta averla in carico;\n#   regola 2) è una macchina di collaudo e il suo ultimo avvio risale\n#             a più di SOGLIA_GIORNI giorni fa: da allora è rimasta sempre accesa.\n#\n# Questo programma non ferma nulla: prepara un elenco, che poi una persona valuterà.\n\nimport numpy as np\nfrom Orange.data import DiscreteVariable, Domain, Table\n\n# --- Parametro: possiamo cambiarlo e poi premere il pulsante Run -------------\nSOGLIA_GIORNI = 30     # giorni di accensione continua tollerati per una macchina di collaudo\n\nMOTIVI = ["senza proprietario", "collaudo accesa da troppo tempo"]\nCOLONNE_NECESSARIE = ["stato", "proprietario", "ambiente", "giorni_dall_avvio"]\n\n\ndef testo(valore):\n    """Restituisce il contenuto di una cella come testo. Una cella vuota diventa una stringa vuota."""\n    scritta = str(valore).strip()\n    # Orange mostra una cella vuota come "?": la trattiamo come vuota.\n    if scritta in ("?", "nan", "None"):\n        return ""\n    return scritta\n\n\ndef proponi_candidate(inventario):\n    """Applica le due regole all\'inventario e restituisce la tabella delle macchine candidate.\n\n    Se non c\'è nulla da proporre restituisce None, che in Python significa «nessun valore».\n    """\n    if inventario is None:\n        print("In attesa dei dati: colleghiamo il widget \'Inventario\' all\'ingresso di questo widget.")\n        return None\n\n    # Controlliamo che la tabella ricevuta contenga le colonne che le regole usano.\n    mancanti = [colonna for colonna in COLONNE_NECESSARIE if colonna not in inventario.domain]\n    if mancanti:\n        print("La tabella in ingresso non è l\'inventario atteso. Colonne mancanti:", ", ".join(mancanti))\n        return None\n\n    righe_candidate = []    # posizione, nell\'inventario, di ogni riga candidata\n    codici_motivo = []      # per ogni riga candidata: 0 = primo motivo dell\'elenco MOTIVI, 1 = secondo\n\n    # Esaminiamo l\'inventario una riga alla volta.\n    for posizione, riga in enumerate(inventario):\n        accesa = testo(riga["stato"]) == "RUNNING"\n        senza_proprietario = testo(riga["proprietario"]) == ""\n        di_collaudo = testo(riga["ambiente"]) == "collaudo"\n        giorni = float(riga["giorni_dall_avvio"])\n\n        if accesa and senza_proprietario:                          # regola 1\n            righe_candidate.append(posizione)\n            codici_motivo.append(0)\n        elif accesa and di_collaudo and giorni &gt; SOGLIA_GIORNI:    # regola 2\n            righe_candidate.append(posizione)\n            codici_motivo.append(1)\n\n    # Riepilogo: compare nella console, il riquadro in basso di questo widget.\n    print("Macchine in inventario:", len(inventario))\n    print("Candidate all\'arresto :", len(righe_candidate))\n    for numero, motivo in enumerate(MOTIVI):\n        print("   -", motivo + ":", codici_motivo.count(numero))\n\n    if not righe_candidate:\n        print("Nessuna macchina soddisfa le regole.")\n        return None\n\n    # Teniamo le sole righe candidate.\n    candidate = inventario[righe_candidate]\n\n    # Quanto costano, in un mese, le macchine candidate (i prezzi del file sono inventati).\n    # Un costo mancante vale "nan" (not a number, cioè «non è un numero»): lo scartiamo.\n    if "costo_mensile_eur" in inventario.domain:\n        costi = [float(riga["costo_mensile_eur"]) for riga in candidate]\n        costi_noti = [costo for costo in costi if not np.isnan(costo)]\n        if costi_noti:\n            print("Costo mensile delle candidate:", round(sum(costi_noti), 2), "euro")\n\n    # Aggiungiamo la colonna "motivo" in fondo alle colonne già presenti.\n    # In Orange il "dominio" è la descrizione delle colonne di una tabella.\n    # Una tabella conserva i numeri in X, la colonna obiettivo in Y (qui non c\'è)\n    # e i testi in metas: li riportiamo tali e quali, aggiungendo a X la nuova colonna.\n    colonna_motivo = DiscreteVariable("motivo", values=MOTIVI)\n    dominio = Domain(\n        list(inventario.domain.attributes) + [colonna_motivo],\n        inventario.domain.class_vars,\n        inventario.domain.metas,\n    )\n    valori = np.column_stack([candidate.X, np.array(codici_motivo, dtype=float)])\n    return Table.from_numpy(dominio, valori, candidate.Y, candidate.metas)\n\n\n# Orange legge il risultato dalla variabile out_data e lo passa al widget successivo.\nout_data = proponi_candidate(in_data)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9f\x00\x00\x00`\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="4" format="literal">{'auto_commit': True, 'color_by_class': True, 'controlAreaVisible': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x07\x80\x00\x00\x04\x10\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x0f\x00\x00\x00\x00\x02\x00\x00\x00\x07\x80\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x0f', 'select_rows': True, 'selected_cols': [], 'selected_rows': [], 'show_attribute_labels': True, 'show_distributions': True, '__version__': 2}</properties>
		<properties node_id="5" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x07\x80\x00\x00\x04\x10\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x0f\x00\x00\x00\x00\x02\x00\x00\x00\x07\x80\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x0f', 'scriptLibrary': [{'name': 'Azione: comandi gcloud (prova a vuoto)', 'script': '# AZIONE, PER FINTA: PREPARIAMO I COMANDI DI ARRESTO\n# ---------------------------------------------------------------------------\n# Che cosa entra : in_data, cioè le righe che abbiamo SELEZIONATO a mano\n#                  nella tabella "Candidate all\'arresto".\n# Che cosa esce  : out_data, cioè un registro con una riga per ogni macchina selezionata:\n#                  nome, zona, motivo, comando, momento della preparazione, esito.\n#\n# "gcloud" è lo strumento a riga di comando di Google Cloud. Il comando\n#     gcloud compute instances stop NOME --zone=ZONA --project=PROGETTO\n# ferma la macchina virtuale che si chiama NOME e si trova nella zona ZONA.\n#\n# Questo programma NON esegue i comandi e NON contatta Google Cloud: li scrive soltanto.\n# È una PROVA A VUOTO (in inglese "dry run"): vediamo che cosa accadrebbe, senza farlo accadere.\n# Eseguire davvero i comandi spetta a una persona autorizzata, fuori da Orange.\n\nfrom datetime import datetime\n\nimport numpy as np\nfrom Orange.data import Domain, StringVariable, Table\n\n# --- Parametro: possiamo cambiarlo e poi premere il pulsante Run -------------\nID_PROGETTO = "id-del-progetto"    # identificativo del progetto Google Cloud (qui è inventato)\n\nCOLONNE_NECESSARIE = ["nome", "zona"]\nCOLONNE_DEL_REGISTRO = ["nome", "zona", "motivo", "comando", "preparato_il", "esito"]\n\n\ndef prepara_comandi(selezionate):\n    """Scrive un comando di arresto per ogni macchina selezionata e restituisce il registro.\n\n    Se non c\'è nulla da preparare restituisce None, che in Python significa «nessun valore».\n    """\n    if selezionate is None or len(selezionate) == 0:\n        print("Nessuna macchina selezionata.")\n        print("Apriamo la tabella \'Candidate all\'arresto\' e selezioniamo le righe da fermare:")\n        print("un clic seleziona una riga, Ctrl+clic ne aggiunge un\'altra, Ctrl+A le seleziona tutte.")\n        return None\n\n    # Controlliamo che la tabella ricevuta contenga le colonne che ci servono.\n    mancanti = [colonna for colonna in COLONNE_NECESSARIE if colonna not in selezionate.domain]\n    if mancanti:\n        print("Nella tabella in ingresso mancano queste colonne:", ", ".join(mancanti))\n        return None\n\n    adesso = datetime.now().strftime("%Y-%m-%d %H:%M")    # data e ora di questa preparazione\n    ha_il_motivo = "motivo" in selezionate.domain\n    righe = []    # una riga del registro per ogni macchina selezionata\n\n    print("PROVA A VUOTO - macchine selezionate:", len(selezionate))\n    print("Comandi che le fermerebbero:")\n    print()\n    for riga in selezionate:\n        nome = str(riga["nome"])\n        zona = str(riga["zona"])\n        motivo = str(riga["motivo"]) if ha_il_motivo else ""\n        comando = ("gcloud compute instances stop " + nome\n                   + " --zone=" + zona + " --project=" + ID_PROGETTO)\n        print(comando)\n        righe.append([nome, zona, motivo, comando, adesso, "non eseguito (prova a vuoto)"])\n    print()\n    print("Nessun comando è stato eseguito.")\n\n    # Il registro è una tabella fatta di sole colonne di testo.\n    # In Orange il "dominio" è la descrizione delle colonne di una tabella.\n    dominio = Domain([], metas=[StringVariable(colonna) for colonna in COLONNE_DEL_REGISTRO])\n    return Table.from_numpy(\n        dominio,\n        np.empty((len(righe), 0)),               # nessuna colonna numerica\n        metas=np.array(righe, dtype=object),     # le colonne di testo\n    )\n\n\n# Orange legge il risultato dalla variabile out_data e lo passa al widget successivo.\nout_data = prepara_comandi(in_data)\n', 'filename': None}], 'scriptText': '# AZIONE, PER FINTA: PREPARIAMO I COMANDI DI ARRESTO\n# ---------------------------------------------------------------------------\n# Che cosa entra : in_data, cioè le righe che abbiamo SELEZIONATO a mano\n#                  nella tabella "Candidate all\'arresto".\n# Che cosa esce  : out_data, cioè un registro con una riga per ogni macchina selezionata:\n#                  nome, zona, motivo, comando, momento della preparazione, esito.\n#\n# "gcloud" è lo strumento a riga di comando di Google Cloud. Il comando\n#     gcloud compute instances stop NOME --zone=ZONA --project=PROGETTO\n# ferma la macchina virtuale che si chiama NOME e si trova nella zona ZONA.\n#\n# Questo programma NON esegue i comandi e NON contatta Google Cloud: li scrive soltanto.\n# È una PROVA A VUOTO (in inglese "dry run"): vediamo che cosa accadrebbe, senza farlo accadere.\n# Eseguire davvero i comandi spetta a una persona autorizzata, fuori da Orange.\n\nfrom datetime import datetime\n\nimport numpy as np\nfrom Orange.data import Domain, StringVariable, Table\n\n# --- Parametro: possiamo cambiarlo e poi premere il pulsante Run -------------\nID_PROGETTO = "id-del-progetto"    # identificativo del progetto Google Cloud (qui è inventato)\n\nCOLONNE_NECESSARIE = ["nome", "zona"]\nCOLONNE_DEL_REGISTRO = ["nome", "zona", "motivo", "comando", "preparato_il", "esito"]\n\n\ndef prepara_comandi(selezionate):\n    """Scrive un comando di arresto per ogni macchina selezionata e restituisce il registro.\n\n    Se non c\'è nulla da preparare restituisce None, che in Python significa «nessun valore».\n    """\n    if selezionate is None or len(selezionate) == 0:\n        print("Nessuna macchina selezionata.")\n        print("Apriamo la tabella \'Candidate all\'arresto\' e selezioniamo le righe da fermare:")\n        print("un clic seleziona una riga, Ctrl+clic ne aggiunge un\'altra, Ctrl+A le seleziona tutte.")\n        return None\n\n    # Controlliamo che la tabella ricevuta contenga le colonne che ci servono.\n    mancanti = [colonna for colonna in COLONNE_NECESSARIE if colonna not in selezionate.domain]\n    if mancanti:\n        print("Nella tabella in ingresso mancano queste colonne:", ", ".join(mancanti))\n        return None\n\n    adesso = datetime.now().strftime("%Y-%m-%d %H:%M")    # data e ora di questa preparazione\n    ha_il_motivo = "motivo" in selezionate.domain\n    righe = []    # una riga del registro per ogni macchina selezionata\n\n    print("PROVA A VUOTO - macchine selezionate:", len(selezionate))\n    print("Comandi che le fermerebbero:")\n    print()\n    for riga in selezionate:\n        nome = str(riga["nome"])\n        zona = str(riga["zona"])\n        motivo = str(riga["motivo"]) if ha_il_motivo else ""\n        comando = ("gcloud compute instances stop " + nome\n                   + " --zone=" + zona + " --project=" + ID_PROGETTO)\n        print(comando)\n        righe.append([nome, zona, motivo, comando, adesso, "non eseguito (prova a vuoto)"])\n    print()\n    print("Nessun comando è stato eseguito.")\n\n    # Il registro è una tabella fatta di sole colonne di testo.\n    # In Orange il "dominio" è la descrizione delle colonne di una tabella.\n    dominio = Domain([], metas=[StringVariable(colonna) for colonna in COLONNE_DEL_REGISTRO])\n    return Table.from_numpy(\n        dominio,\n        np.empty((len(righe), 0)),               # nessuna colonna numerica\n        metas=np.array(righe, dtype=object),     # le colonne di testo\n    )\n\n\n# Orange legge il risultato dalla variabile out_data e lo passa al widget successivo.\nout_data = prepara_comandi(in_data)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9f\x00\x00\x00`\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="6" format="literal">{'auto_commit': True, 'color_by_class': True, 'controlAreaVisible': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x07\x80\x00\x00\x04\x10\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x0f\x00\x00\x00\x00\x02\x00\x00\x00\x07\x80\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x0f', 'select_rows': True, 'selected_cols': [], 'selected_rows': [], 'show_attribute_labels': True, 'show_distributions': True, '__version__': 2}</properties>
		<properties node_id="7" format="literal">{'add_type_annotations': False, 'auto_save': False, 'controlAreaVisible': True, 'filter': 'Comma-separated values (*.csv)', 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x03M\x00\x00\x01\x9e\x00\x00\x04\xe1\x00\x00\x02T\x00\x00\x03N\x00\x00\x01\xbd\x00\x00\x04\xe0\x00\x00\x02S\x00\x00\x00\x00\x00\x00\x00\x00\x07\x80\x00\x00\x03N\x00\x00\x01\xbd\x00\x00\x04\xe0\x00\x00\x02S', 'stored_name': '', 'stored_path': '.', '__version__': 3}</properties>
		<properties node_id="8" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x07\x80\x00\x00\x04\x10\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x0f\x00\x00\x00\x00\x02\x00\x00\x00\x07\x80\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x0f', 'scriptLibrary': [{'name': 'Inventario dal vivo da Google Cloud', 'script': '# FACOLTATIVO - L\'INVENTARIO LETTO DAL VIVO DA GOOGLE CLOUD\n# ---------------------------------------------------------------------------\n# Questo widget non è collegato agli altri: il workflow funziona anche senza.\n# Mostra come l\'inventario potrebbe arrivare direttamente da Google Cloud,\n# invece che da un file esportato a mano.\n#\n# Finché ID_PROGETTO resta vuoto, il programma non contatta nessuno.\n# Per provarlo servono tre cose:\n#   1) la libreria google-cloud-compute, installata nell\'ambiente Python usato da Orange;\n#   2) credenziali valide per Google Cloud sul computer;\n#   3) l\'identificativo di un progetto DI PROVA, da scrivere qui sotto in ID_PROGETTO.\n# Poi premiamo Run e colleghiamo l\'uscita di questo widget ai tre widget\n# che ora ricevono i dati dal widget "Inventario".\n#\n# Il programma legge soltanto: non modifica e non ferma nulla.\n# Non è stato provato su un progetto reale: va collaudato prima di fidarsi.\n\nfrom datetime import datetime, timezone\n\nimport numpy as np\nfrom Orange.data import ContinuousVariable, DiscreteVariable, Domain, StringVariable, Table\n\n# --- Parametri: possiamo cambiarli e poi premere il pulsante Run -------------\nID_PROGETTO = ""                            # finché resta vuoto, il programma non contatta nessuno\n\n# Un progetto può ospitare macchine di ogni genere, non solo desktop.\n# Teniamo solo le macchine che portano questa etichetta. Il nome dell\'etichetta è inventato:\n# quello vero va chiesto a chi gestisce le macchine.\nETICHETTA_DESKTOP = ("ruolo", "desktop")\n\nCOLONNE_A_CATEGORIE = ["zona", "tipo_macchina", "stato", "ambiente", "ufficio"]\nCOLONNE_DI_TESTO = ["nome", "proprietario", "ultimo_avvio"]\n\n\ndef giorni_da(istante):\n    """Giorni trascorsi dall\'istante indicato, scritto come testo (per esempio 2026-11-03T08:15:00+01:00).\n\n    Se l\'istante manca o non è leggibile restituisce "nan" (not a number, cioè «non è un numero»).\n    """\n    if not istante:\n        return float("nan")\n    try:\n        momento = datetime.fromisoformat(istante)\n    except ValueError:\n        return float("nan")\n    return float((datetime.now(timezone.utc) - momento).days)\n\n\ndef colonna_a_categorie(nome, testi):\n    """Prepara una colonna a categorie: restituisce la descrizione della colonna e i codici numerici.\n\n    Orange conserva una categoria come numero: 0 per la prima, 1 per la seconda e così via.\n    """\n    categorie = sorted(set(t for t in testi if t != ""))\n    codici = [float(categorie.index(t)) if t != "" else float("nan") for t in testi]\n    return DiscreteVariable(nome, values=categorie), codici\n\n\ndef leggi_inventario(id_progetto):\n    """Legge da Compute Engine i desktop di un progetto e restituisce una tabella di Orange.\n\n    Se non c\'è nulla da restituire, restituisce None, che in Python significa «nessun valore».\n    """\n    if id_progetto == "":\n        print("ID_PROGETTO è vuoto: nessuna richiesta inviata a Google Cloud.")\n        return None\n\n    try:\n        from google.cloud import compute_v1\n    except ImportError:\n        print("La libreria google-cloud-compute non è installata nell\'ambiente Python di Orange.")\n        return None\n\n    macchine = []\n    try:\n        # Il "client" è l\'oggetto della libreria che parla con Compute Engine per nostro conto.\n        client = compute_v1.InstancesClient()\n        richiesta = compute_v1.AggregatedListInstancesRequest(project=id_progetto)\n\n        # aggregated_list restituisce le macchine raggruppate per zona e scorre da sola le pagine.\n        for zona, gruppo in client.aggregated_list(request=richiesta):\n            for macchina in gruppo.instances:\n                etichette = dict(macchina.labels)    # le etichette, come normale dizionario Python\n                if etichette.get(ETICHETTA_DESKTOP[0]) != ETICHETTA_DESKTOP[1]:\n                    continue    # non è un desktop: la saltiamo\n                macchine.append({\n                    "nome": macchina.name,\n                    "zona": zona.split("/")[-1],\n                    "tipo_macchina": macchina.machine_type.split("/")[-1],\n                    "stato": macchina.status,\n                    "ambiente": etichette.get("ambiente", ""),\n                    "ufficio": etichette.get("ufficio", ""),\n                    "proprietario": etichette.get("proprietario", ""),\n                    "ultimo_avvio": macchina.last_start_timestamp,\n                    "giorni_dall_avvio": giorni_da(macchina.last_start_timestamp),\n                })\n    except Exception as errore:\n        # Intercettiamo qualunque errore (credenziali mancanti, permessi insufficienti,\n        # rete assente) per mostrare un messaggio breve al posto di un lungo elenco tecnico.\n        print("La lettura da Google Cloud non è riuscita:", errore)\n        return None\n\n    print("Desktop trovati nel progetto:", len(macchine))\n    if not macchine:\n        return None\n\n    # Costruiamo una tabella con le stesse colonne del file dimostrativo:\n    # così il resto del workflow funziona senza modifiche.\n    variabili, colonne = [], []\n    for nome in COLONNE_A_CATEGORIE:\n        variabile, codici = colonna_a_categorie(nome, [m[nome] for m in macchine])\n        variabili.append(variabile)\n        colonne.append(codici)\n\n    variabili.append(ContinuousVariable("giorni_dall_avvio"))\n    colonne.append([m["giorni_dall_avvio"] for m in macchine])\n\n    # Il costo non fa parte dell\'inventario: arriva dalla fatturazione. Lo lasciamo vuoto.\n    variabili.append(ContinuousVariable("costo_mensile_eur"))\n    colonne.append([float("nan")] * len(macchine))\n\n    # In Orange il "dominio" è la descrizione delle colonne di una tabella.\n    dominio = Domain(variabili, metas=[StringVariable(nome) for nome in COLONNE_DI_TESTO])\n    testi = [[m[nome] for nome in COLONNE_DI_TESTO] for m in macchine]\n    return Table.from_numpy(\n        dominio,\n        np.column_stack(colonne),                # le colonne numeriche e a categorie\n        metas=np.array(testi, dtype=object),     # le colonne di testo\n    )\n\n\n# Orange legge il risultato dalla variabile out_data e lo passa al widget successivo.\nout_data = leggi_inventario(ID_PROGETTO)\n', 'filename': None}], 'scriptText': '# FACOLTATIVO - L\'INVENTARIO LETTO DAL VIVO DA GOOGLE CLOUD\n# ---------------------------------------------------------------------------\n# Questo widget non è collegato agli altri: il workflow funziona anche senza.\n# Mostra come l\'inventario potrebbe arrivare direttamente da Google Cloud,\n# invece che da un file esportato a mano.\n#\n# Finché ID_PROGETTO resta vuoto, il programma non contatta nessuno.\n# Per provarlo servono tre cose:\n#   1) la libreria google-cloud-compute, installata nell\'ambiente Python usato da Orange;\n#   2) credenziali valide per Google Cloud sul computer;\n#   3) l\'identificativo di un progetto DI PROVA, da scrivere qui sotto in ID_PROGETTO.\n# Poi premiamo Run e colleghiamo l\'uscita di questo widget ai tre widget\n# che ora ricevono i dati dal widget "Inventario".\n#\n# Il programma legge soltanto: non modifica e non ferma nulla.\n# Non è stato provato su un progetto reale: va collaudato prima di fidarsi.\n\nfrom datetime import datetime, timezone\n\nimport numpy as np\nfrom Orange.data import ContinuousVariable, DiscreteVariable, Domain, StringVariable, Table\n\n# --- Parametri: possiamo cambiarli e poi premere il pulsante Run -------------\nID_PROGETTO = ""                            # finché resta vuoto, il programma non contatta nessuno\n\n# Un progetto può ospitare macchine di ogni genere, non solo desktop.\n# Teniamo solo le macchine che portano questa etichetta. Il nome dell\'etichetta è inventato:\n# quello vero va chiesto a chi gestisce le macchine.\nETICHETTA_DESKTOP = ("ruolo", "desktop")\n\nCOLONNE_A_CATEGORIE = ["zona", "tipo_macchina", "stato", "ambiente", "ufficio"]\nCOLONNE_DI_TESTO = ["nome", "proprietario", "ultimo_avvio"]\n\n\ndef giorni_da(istante):\n    """Giorni trascorsi dall\'istante indicato, scritto come testo (per esempio 2026-11-03T08:15:00+01:00).\n\n    Se l\'istante manca o non è leggibile restituisce "nan" (not a number, cioè «non è un numero»).\n    """\n    if not istante:\n        return float("nan")\n    try:\n        momento = datetime.fromisoformat(istante)\n    except ValueError:\n        return float("nan")\n    return float((datetime.now(timezone.utc) - momento).days)\n\n\ndef colonna_a_categorie(nome, testi):\n    """Prepara una colonna a categorie: restituisce la descrizione della colonna e i codici numerici.\n\n    Orange conserva una categoria come numero: 0 per la prima, 1 per la seconda e così via.\n    """\n    categorie = sorted(set(t for t in testi if t != ""))\n    codici = [float(categorie.index(t)) if t != "" else float("nan") for t in testi]\n    return DiscreteVariable(nome, values=categorie), codici\n\n\ndef leggi_inventario(id_progetto):\n    """Legge da Compute Engine i desktop di un progetto e restituisce una tabella di Orange.\n\n    Se non c\'è nulla da restituire, restituisce None, che in Python significa «nessun valore».\n    """\n    if id_progetto == "":\n        print("ID_PROGETTO è vuoto: nessuna richiesta inviata a Google Cloud.")\n        return None\n\n    try:\n        from google.cloud import compute_v1\n    except ImportError:\n        print("La libreria google-cloud-compute non è installata nell\'ambiente Python di Orange.")\n        return None\n\n    macchine = []\n    try:\n        # Il "client" è l\'oggetto della libreria che parla con Compute Engine per nostro conto.\n        client = compute_v1.InstancesClient()\n        richiesta = compute_v1.AggregatedListInstancesRequest(project=id_progetto)\n\n        # aggregated_list restituisce le macchine raggruppate per zona e scorre da sola le pagine.\n        for zona, gruppo in client.aggregated_list(request=richiesta):\n            for macchina in gruppo.instances:\n                etichette = dict(macchina.labels)    # le etichette, come normale dizionario Python\n                if etichette.get(ETICHETTA_DESKTOP[0]) != ETICHETTA_DESKTOP[1]:\n                    continue    # non è un desktop: la saltiamo\n                macchine.append({\n                    "nome": macchina.name,\n                    "zona": zona.split("/")[-1],\n                    "tipo_macchina": macchina.machine_type.split("/")[-1],\n                    "stato": macchina.status,\n                    "ambiente": etichette.get("ambiente", ""),\n                    "ufficio": etichette.get("ufficio", ""),\n                    "proprietario": etichette.get("proprietario", ""),\n                    "ultimo_avvio": macchina.last_start_timestamp,\n                    "giorni_dall_avvio": giorni_da(macchina.last_start_timestamp),\n                })\n    except Exception as errore:\n        # Intercettiamo qualunque errore (credenziali mancanti, permessi insufficienti,\n        # rete assente) per mostrare un messaggio breve al posto di un lungo elenco tecnico.\n        print("La lettura da Google Cloud non è riuscita:", errore)\n        return None\n\n    print("Desktop trovati nel progetto:", len(macchine))\n    if not macchine:\n        return None\n\n    # Costruiamo una tabella con le stesse colonne del file dimostrativo:\n    # così il resto del workflow funziona senza modifiche.\n    variabili, colonne = [], []\n    for nome in COLONNE_A_CATEGORIE:\n        variabile, codici = colonna_a_categorie(nome, [m[nome] for m in macchine])\n        variabili.append(variabile)\n        colonne.append(codici)\n\n    variabili.append(ContinuousVariable("giorni_dall_avvio"))\n    colonne.append([m["giorni_dall_avvio"] for m in macchine])\n\n    # Il costo non fa parte dell\'inventario: arriva dalla fatturazione. Lo lasciamo vuoto.\n    variabili.append(ContinuousVariable("costo_mensile_eur"))\n    colonne.append([float("nan")] * len(macchine))\n\n    # In Orange il "dominio" è la descrizione delle colonne di una tabella.\n    dominio = Domain(variabili, metas=[StringVariable(nome) for nome in COLONNE_DI_TESTO])\n    testi = [[m[nome] for nome in COLONNE_DI_TESTO] for m in macchine]\n    return Table.from_numpy(\n        dominio,\n        np.column_stack(colonne),                # le colonne numeriche e a categorie\n        metas=np.array(testi, dtype=object),     # le colonne di testo\n    )\n\n\n# Orange legge il risultato dalla variabile out_data e lo passa al widget successivo.\nout_data = leggi_inventario(ID_PROGETTO)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9f\x00\x00\x00`\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
